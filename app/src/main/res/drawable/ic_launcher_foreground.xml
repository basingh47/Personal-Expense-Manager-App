<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Glowing background aura behind the core emblem to make it pop -->
    <path
        android:pathData="M54,54m-28,0a28,28 0 1,1 56,0a28,28 0 1,1 -56,0"
        android:fillAlpha="0.15">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="28"
                android:type="radial">
                <item android:color="#00E676" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Main Shield / Frame for security & wealth protection -->
    <path
        android:pathData="M54,22 L78,31 L78,54 C78,69.5 67.5,77 54,81 C40.5,77 30,69.5 30,54 L30,31 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="22"
                android:endX="78"
                android:endY="81"
                android:type="linear">
                <item android:color="#2196F3" android:offset="0.0"/>
                <item android:color="#0D47A1" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Inner shield gold trim border -->
    <path
        android:pathData="M54,25 L75,33 L75,54 C75,67 66,73.5 54,77 C42,73.5 33,67 33,54 L33,33 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#FFD700"
        android:fillColor="#00000000"/>

    <!-- 4. Premium Gold Coins inside the shield -->
    <!-- First Coin (Background coin, slightly offset) -->
    <path
        android:pathData="M46,55m-10,0a10,10 0 1,1 20,0a10,10 0 1,1 -20,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="45"
                android:endX="56"
                android:endY="65"
                android:type="linear">
                <item android:color="#FFD700" android:offset="0.0"/>
                <item android:color="#FF8F00" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Second Coin (Foreground coin, centered) -->
    <path
        android:pathData="M58,58m-11,0a11,11 0 1,1 22,0a11,11 0 1,1 -22,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="47"
                android:startY="47"
                android:endX="69"
                android:endY="69"
                android:type="linear">
                <item android:color="#FFF9C4" android:offset="0.0"/>
                <item android:color="#FFD700" android:offset="0.3"/>
                <item android:color="#FF8F00" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- Coin Inner Dollar Symbol Details -->
    <path
        android:pathData="M58,52 L58,64 M55,54 C52,54 52,58 55,58 C58,58 58,62 61,62 C64,62 64,58 61,58"
        android:strokeWidth="2"
        android:strokeColor="#FFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

    <!-- 5. Neon Emerald Trend Upward Arrow overlay -->
    <!-- Curved Line path -->
    <path
        android:pathData="M34,66 C42,60 48,64 56,52 C62,43 70,36 76,34"
        android:strokeWidth="4"
        android:strokeColor="#00E676"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>

    <!-- Arrow head pointing top right -->
    <path
        android:pathData="M68,34 L76,34 L76,42"
        android:strokeWidth="4"
        android:strokeColor="#00E676"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>

    <!-- Arrow head glowing inner line -->
    <path
        android:pathData="M34,66 C42,60 48,64 56,52 C62,43 70,36 76,34"
        android:strokeWidth="1.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>

    <path
        android:pathData="M68,34 L76,34 L76,42"
        android:strokeWidth="1.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>

    <!-- Accent: Sparkle/Star in top-right area representing luxury savings -->
    <path
        android:pathData="M78,24 L80,26 L82,24 L80,22 Z"
        android:fillColor="#FFFFFF"/>
    <path
        android:pathData="M40,36 L41,37 L42,36 L41,35 Z"
        android:fillColor="#FFFFFF"/>
</vector>
