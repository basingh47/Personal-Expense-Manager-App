# Example Production Release Keystore Configuration
# Copy this file to keystore.properties and update with your production keystore details:
# storeFile=/path/to/your/upload-keystore.jks
# storePassword=your_store_password
# keyAlias=your_key_alias
# keyPassword=your_key_password

storeFile=../my-upload-key.jks
storePassword=releasepass123
keyAlias=upload
keyPassword=releasepass123
